# Virtual environment
.venv/

# Python bytecode
__pycache__/
*.py[cod]

# Cached datasets (re-downloaded automatically on first run)
data/*.csv

# Per-configuration prediction dumps (regenerated by experiment.py)
results/predictions/

# Persisted models (large, regenerated by src/persist_models.py).
# The metadata and held-out sample are kept, since they document the model.
models/*.joblib

# OS noise
.DS_Store
